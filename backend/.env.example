# ==============================================================================
# Trinetra Backend Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO `.env` AND FILL IN PRODUCTION / ENVIRONMENT SPECIFIC VALUES.
# NEVER COMMIT ACTUAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Metadata
PROJECT_NAME="Trinetra - AI Fake Identity & Document Fraud Detection"
API_V1_STR="/api"

# Database Connection (MongoDB)
# Local instance: mongodb://localhost:27017
# Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DATABASE="trinetra_db"

# JWT Authentication & Security
# Generate a high-entropy secret for production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="change-this-to-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Operational Mode
# Set to 'false' for live AI/ML models (ELA Forensics, Face Verification, Passive Liveness)
# Set to 'true' for mock mode (lightweight offline testing)
USE_MOCK_MODE=false

# Optional Cloud Storage (Cloudinary Integration)
# Leave blank to use local filesystem storage in backend/storage/
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
