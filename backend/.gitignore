# Storage & Uploads (Ignore user uploads, preserve directory structure)
storage/documents/*
!storage/documents/.gitkeep
storage/biometrics/*
!storage/biometrics/.gitkeep

# Logs
logs/*
!logs/.gitkeep
*.log

# IDE & OS Artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
