# Python Environments
venv/
.venv/
env/
ENV/

# Python Bytecode & Cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.installed.cfg
*.egg

# Secrets & Environment Files
.env
